# Team-Ops configuration
# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL — use localhost when the API runs on the host (`make api-dev`).
# `docker compose up` ignores this and talks to the `postgres` service instead.
# External hosts: see docs/deployment/external-postgres.md
DATABASE_URL=postgres://teamops:teamops@localhost:5432/teamops?sslmode=disable

# API
HTTP_ADDR=:8080
APP_URL=http://localhost:3000
LOG_LEVEL=info
COOKIE_SECURE=false
SEED_ON_START=false

# Web (Next.js)
API_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE=/v1

# MCP (used by the agent adapter, not by the API)
TEAM_OPS_URL=http://localhost:8080
TEAM_OPS_TOKEN=

# Optional: disable the bundled Postgres service when using an external database.
# COMPOSE_PROFILES=  (leave empty)
# See docs/deployment/external-postgres.md
