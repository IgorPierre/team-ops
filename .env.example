# Team-Ops configuration
# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL — use localhost when the API runs on the host (`make api-dev`).
# `docker compose up` ignores this and talks to the `postgres` service instead.
# External hosts: see docs/deployment/external-postgres.md
DATABASE_URL=postgres://teamops:teamops@localhost:5432/teamops?sslmode=disable

# Password for the bundled Postgres container (docker compose). Set it before
# the first `docker compose up`; changing it later needs a manual ALTER USER.
POSTGRES_PASSWORD=teamops

# API
HTTP_ADDR=:8080
# Vercel supplies PORT automatically; leave HTTP_ADDR unset there.
# Run migrations separately in serverless deployments.
MIGRATE_ON_START=true
APP_URL=http://localhost:3000
LOG_LEVEL=info
COOKIE_SECURE=false
# After the first account exists, registration needs an invite (recommended).
# Set true only for a public demo.
REGISTRATION_OPEN=false

# Web (Next.js)
API_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE=/v1

# The API port is published on 127.0.0.1 only; agents use the web URL.
# API_BIND=0.0.0.0

# MCP (used by the agent adapter, not by the API)
TEAM_OPS_URL=http://localhost:8080
TEAM_OPS_TOKEN=

# Install skill + MCP in your coding repo:
#   npx @team-ops/setup

# Optional: disable the bundled Postgres service when using an external database.
# COMPOSE_PROFILES=  (leave empty)
# See docs/deployment/external-postgres.md
