{
  "name": "@team-ops/mcp",
  "version": "0.1.0",
  "description": "Team-Ops MCP server over stdio, for scripts and CI (API key). Editors use the hosted /mcp endpoint with OAuth.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "team-ops-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IgorPierre/team-ops",
    "directory": "apps/mcp"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node build.mjs",
    "prepack": "npm run build",
    "lint": "echo 'ok'",
    "test": "echo 'tests live in packages/mcp-server'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@team-ops/api-client": "*",
    "@types/node": "^22.15.18",
    "esbuild": "^0.25.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "@team-ops/mcp-server": "*"
  }
}
