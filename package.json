{
  "name": "team-ops",
  "private": true,
  "version": "0.1.0",
  "description": "The self-hosted engineering board for humans and AI agents.",
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "apps/website",
    "apps/mcp",
    "apps/setup",
    "packages/api-client"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
